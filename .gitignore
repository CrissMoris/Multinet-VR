# Unity project (subfolder) — generated by Unity; never commit
# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/MultiTravelValizChallenge/[Ll]ibrary/
/MultiTravelValizChallenge/[Tt]emp/
/MultiTravelValizChallenge/[Oo]bj/
/MultiTravelValizChallenge/[Bb]uild/
/MultiTravelValizChallenge/[Bb]uilds/
/MultiTravelValizChallenge/[Ll]ogs/
/MultiTravelValizChallenge/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/MultiTravelValizChallenge/[Mm]emoryCaptures/

# Recordings can get excessive in size
/MultiTravelValizChallenge/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/MultiTravelValizChallenge/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/MultiTravelValizChallenge/[Aa]ssets/StreamingAssets/aa*
/MultiTravelValizChallenge/[Aa]ssets/AddressableAssetsData/link.xml*
/MultiTravelValizChallenge/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/MultiTravelValizChallenge/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/MultiTravelValizChallenge/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/MultiTravelValizChallenge/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/MultiTravelValizChallenge/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/MultiTravelValizChallenge/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/MultiTravelValizChallenge/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/UIElementsSchema/

# Auto-generated cache in Assets folder
/MultiTravelValizChallenge/[Aa]ssets/[Ss]ceneDependencyCache*

# Project-specific
/MultiTravelValizChallenge/Build/
/MultiTravelValizChallenge/*.slnx
/MultiTravelValizChallenge/.vscode/
/MultiTravelValizChallenge/test-results*.xml
/MultiTravelValizChallenge/CodeCoverage/
/backend/supabase/.temp/
/backend/supabase/.branches/
/leaderboard-web/config.local.js
/MultiTravelValizChallenge/Assets/StreamingAssets/multitravel.config.json
/MultiTravelValizChallenge/Assets/StreamingAssets/multitravel.config.json.meta
/TestResults/commands.json
node_modules/
.env
.env.*
*.log

# Event deployment secrets (station config with access code, production leaderboard config)
/Deployment/*.json
/Deployment/*.js

# Local tooling / generated output
/TestResults/
__pycache__/
*.pyc
