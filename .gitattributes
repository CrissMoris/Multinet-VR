# Keep Unity YAML/text assets byte-exact (no line-ending conversion)
* -text
*.cs text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
# Binary assets
*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.fbx binary
*.wav binary
*.mp4 binary
